# =====================================================
# HVAC IoT System - Production Environment Variables
# =====================================================
# Copy this file to .env and update with your values
# NEVER commit .env files with real credentials!

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DB_NAME=hvac_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here

# =====================================================
# MQTT BROKER CONFIGURATION
# =====================================================
MOSQUITTO_HOST=trolley.proxy.rlwy.net
MOSQUITTO_PORT=26703
MOSQUITTO_USERNAME=hvac-monitoring-system
MOSQUITTO_PASSWORD=your_mqtt_password_here

# =====================================================
# JWT AUTHENTICATION
# =====================================================
# Generate a secure random string (min 256 bits / 32 chars)
# You can use: openssl rand -base64 32
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_256_bits_long
JWT_EXPIRATION=21600000

# =====================================================
# EMAIL CONFIGURATION (For 2FA)
# =====================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# =====================================================
# GOOGLE OAUTH2 (Optional)
# =====================================================
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =====================================================
# CORS CONFIGURATION
# =====================================================
CORS_ALLOWED_ORIGINS=https://live-ac.tech,https://www.live-ac.tech

# =====================================================
# FRONTEND CONFIGURATION
# =====================================================
NEXT_PUBLIC_API_URL=https://api.live-ac.tech
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# =====================================================
# DOMAIN CONFIGURATION (For Traefik/Dokploy)
# =====================================================
DOMAIN=live-ac.tech
API_DOMAIN=api.live-ac.tech
